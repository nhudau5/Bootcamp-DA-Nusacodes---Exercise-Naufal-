        p.product_category_name,
        COALESCE(c.product_category_name_english, 'unknown') AS product_category_english,
        p.product_weight_g,
        p.product_length_cm,
        p.product_height_cm,
        p.product_width_cm
    FROM source_product p
    LEFT JOIN source_category c
        ON p.product_category_name = c.product_category_name
)

SELECT * FROM joined
